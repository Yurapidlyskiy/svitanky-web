# Copy this file to .env.local (git-ignored) and fill in the values.
# Setup guide: docs/architecture/payments.md
#
# The WayForPay secret key belongs only in .env.local and in the hosting provider's
# environment settings: never in the repo, never in chat, never in a NEXT_PUBLIC_ variable.

# Public address of the site, no trailing slash. It is the base of canonical links, the sitemap
# and the addresses WayForPay calls back (/api/payments/wayforpay/callback and .../return), so in
# production it must be the real domain. Read at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WayForPay settings, from the store settings in the WayForPay cabinet. While any of the three
# is empty the site works as usual and the donation forms say payments are temporarily unavailable.
WAYFORPAY_MERCHANT_ACCOUNT=
# The store domain exactly as registered in WayForPay, host only (for example svitanky.org.ua).
WAYFORPAY_MERCHANT_DOMAIN=
WAYFORPAY_SECRET_KEY=
